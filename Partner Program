    el.addEventListener('click', function(){ showPage(el.dataset.goto); });
  });

  // Progress bar based on scroll within active page
  function updateProgress(){
    var h = document.documentElement.scrollHeight - window.innerHeight;
    var pct = h > 0 ? (window.scrollY / h) * 100 : 0;
    document.getElementById('progressBar').style.width = pct + '%';
  }
  window.addEventListener('scroll', updateProgress, {passive:true});

  // Tier cards expand
  document.querySelectorAll('.tier-card').forEach(function(card){
    function toggle(){
      var ex = card.classList.toggle('expanded');
      card.setAttribute('aria-expanded', ex ? 'true':'false');
    }
    card.addEventListener('click', toggle);
    card.addEventListener('keydown', function(e){
      if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); toggle(); }
    });
  });

  // Print
  ['printBtn','printBtn2'].forEach(function(id){
    var b = document.getElementById(id);
    if(b) b.addEventListener('click', function(){ window.print(); });
  });

  updateProgress();
})();
