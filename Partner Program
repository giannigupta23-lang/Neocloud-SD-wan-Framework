<header class="site-nav">
  <div class="progress-bar" id="progressBar"></div>
  <div class="nav-inner">
    <div class="brand">
      <svg class="cisco-logo" viewBox="0 0 130 40" aria-label="Cisco" role="img">
        <g fill="#049fd9">
          <rect x="0"  y="16" width="4" height="8"  rx="2"/>
          <rect x="10" y="8"  width="4" height="24" rx="2"/>
          <rect x="20" y="2"  width="4" height="36" rx="2"/>
          <rect x="30" y="8"  width="4" height="24" rx="2"/>
          <rect x="40" y="16" width="4" height="8"  rx="2"/>
        </g>
        <text x="52" y="27" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="700" fill="#049fd9" letter-spacing="0.5">cisco</text>
      </svg>
      <span class="brand-divider"></span> Secure AI Harness
    </div>
    <div class="page-tabs" id="pageTabs">
      <button data-page="one" class="active">1 · Vision &amp; Model</button>
      <button data-page="two">2 · The Cisco Gate</button>
      <button data-page="three">3 · Adoption Tiers &amp; Journey</button>
      <button data-page="four">4 · Pilot &amp; Next Step</button>
    </div>
    <div class="nav-cta no-print"><button class="btn btn-ghost" id="printBtn">Print / PDF</button></div>
  </div>
</header>

