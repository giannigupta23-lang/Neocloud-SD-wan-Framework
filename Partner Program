<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cisco Secure AI Tokens — Strategy &amp; Working Session</title>
<meta name="description" content="Cisco Secure AI Tokens: a conceptual, merchant-of-record consumption model for secure enterprise access to approved AI models and infrastructure.">
<style>
  :root{
    --navy-900:#050b16;--navy-800:#0a1628;--navy-700:#0f2038;--navy-600:#152c4a;--navy-500:#1c3a5e;
    --blue:#049fd9;--blue-dark:#0a3d62;--blue-light:#5fc8ef;--teal:#00c2b3;--teal-light:#5be0d3;
    --gold:#d4af37;--gold-soft:#f0d98a;--platinum:#c9d3dc;--platinum-soft:#e6ebf0;--diamond:#5fc8ef;
    --white:#f4f9fc;--text:#e7eef5;--text-muted:#9fb3c8;--text-dim:#7488a0;
    --border:rgba(255,255,255,0.09);--border-strong:rgba(255,255,255,0.16);
    --radius-lg:18px;--radius-md:12px;--radius-sm:8px;--shadow-card:0 10px 30px rgba(0,0,0,0.35);
    --maxw:1180px;--nav-h:66px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:var(--navy-900);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased;}
  a{color:inherit;text-decoration:none;}
  ul,ol{margin:0;padding:0;}
  h1,h2,h3,h4{margin:0 0 .5em 0;font-weight:700;letter-spacing:-0.01em;}
  p{margin:0 0 1em 0;color:var(--text-muted);}
  .container{max-width:var(--maxw);margin:0 auto;padding:0 24px;}
  .page{display:none;animation:fade .4s ease;}
  .page.active{display:block;}
  @keyframes fade{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}
  section{padding:64px 0;border-bottom:1px solid var(--border);}
  section:last-child{border-bottom:none;}
  .section-alt{background:linear-gradient(180deg,var(--navy-800),var(--navy-900));}
  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--teal-light);margin-bottom:14px;}
  .eyebrow::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--teal);box-shadow:0 0 12px var(--teal);}
  .section-title{font-size:clamp(26px,4vw,38px);color:var(--white);}
  .section-subtitle{max-width:760px;font-size:16.5px;}
  .section-head{margin-bottom:40px;}
  .tag{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;padding:4px 10px;border-radius:999px;border:1px solid var(--border-strong);color:var(--text-muted);background:rgba(255,255,255,0.04);}
  .tag-conceptual{color:var(--blue-light);border-color:rgba(4,159,217,.4);background:rgba(4,159,217,.08);}
  .tag-illustrative{color:var(--teal-light);border-color:rgba(0,194,179,.4);background:rgba(0,194,179,.08);}
  .tag-validation{color:var(--gold);border-color:rgba(212,175,55,.4);background:rgba(212,175,55,.08);}
  .tag-hypothesis{color:#c9a0ff;border-color:rgba(180,140,255,.4);background:rgba(180,140,255,.08);}
  .tag-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px;}
  .chip{font-size:12.5px;padding:5px 11px;border-radius:999px;background:rgba(255,255,255,0.05);border:1px solid var(--border);color:var(--text-muted);}
  .chip-row{display:flex;flex-wrap:wrap;gap:7px;}
  .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:999px;font-weight:700;font-size:14.5px;cursor:pointer;border:1px solid transparent;transition:transform .15s,box-shadow .15s;font-family:inherit;}
  .btn:hover{transform:translateY(-2px);}
  .btn-primary{background:linear-gradient(135deg,var(--blue),var(--teal));color:#04121f;box-shadow:0 8px 24px rgba(4,159,217,.35);}
  .btn-ghost{background:transparent;border-color:var(--border-strong);color:var(--text);}
  .btn-ghost:hover{border-color:var(--blue-light);}

  /* NAV */
  header.site-nav{position:sticky;top:0;z-index:100;background:rgba(5,11,22,0.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);}
  .progress-bar{height:3px;background:linear-gradient(90deg,var(--blue),var(--teal));width:0;transition:width .2s;}
  .nav-inner{max-width:var(--maxw);margin:0 auto;padding:0 24px;height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;gap:18px;}
  .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:15px;color:var(--white);flex:0 0 auto;}
  .brand-mark{width:26px;height:26px;border-radius:7px;background:linear-gradient(135deg,var(--blue),var(--teal));}
  nav.nav-links{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;flex:1 1 auto;justify-content:center;}
  nav.nav-links::-webkit-scrollbar{display:none;}
  nav.nav-links button{font-family:inherit;font-size:13px;font-weight:600;color:var(--text-muted);padding:8px 12px;border-radius:8px;white-space:nowrap;background:none;border:none;cursor:pointer;transition:.2s;}
  nav.nav-links button:hover,nav.nav-links button.active{color:var(--white);background:rgba(255,255,255,0.07);}
  .nav-cta .btn{padding:9px 16px;font-size:13px;}

  .hero{padding:96px 0 72px;background:radial-gradient(circle at 15% 10%,rgba(4,159,217,0.18),transparent 55%),radial-gradient(circle at 85% 30%,rgba(0,194,179,0.16),transparent 55%),var(--navy-900);}
  .hero h1{font-size:clamp(36px,6vw,60px);color:var(--white);line-height:1.05;background:linear-gradient(120deg,#fff 30%,var(--blue-light) 70%,var(--teal-light) 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
  .hero .lede{font-size:18px;max-width:660px;}
  .hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin:26px 0 34px;}
  .hero-note{font-size:13px;color:var(--text-dim);border-left:2px solid var(--blue);padding-left:12px;max-width:660px;}
  .premise{margin-top:34px;border-left:3px solid var(--teal);background:rgba(0,194,179,0.06);border-radius:var(--radius-md);padding:20px 24px;font-size:16px;color:var(--white);font-weight:600;line-height:1.5;max-width:820px;}

  .grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;}
  .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .card{background:linear-gradient(160deg,rgba(255,255,255,0.045),rgba(255,255,255,0.015));border:1px solid var(--border);border-radius:var(--radius-lg);padding:26px;box-shadow:var(--shadow-card);transition:transform .2s,border-color .2s;}
  .card:hover{transform:translateY(-4px);border-color:var(--border-strong);}
  .card h3{color:var(--white);font-size:18px;}
  .card h4{color:var(--white);font-size:15px;}
  .card .icon{width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--blue),var(--teal));margin-bottom:14px;font-size:20px;}
  .card ul{list-style:none;display:flex;flex-direction:column;gap:7px;margin-top:8px;}
  .card li{font-size:13.5px;color:var(--text-muted);padding-left:18px;position:relative;}
  .card li::before{content:"›";position:absolute;left:0;color:var(--teal-light);font-weight:800;}

  /* Ecosystem diagram */
  .eco-diagram{position:relative;width:100%;aspect-ratio:1/1;max-width:460px;margin:0 auto;}
  .eco-diagram svg{position:absolute;inset:0;width:100%;height:100%;}
  .eco-diagram svg line{stroke:var(--border-strong);stroke-width:1.5;stroke-dasharray:4 4;}
  .eco-node{position:absolute;transform:translate(-50%,-50%);z-index:2;background:var(--navy-800);border:1px solid var(--border-strong);border-radius:var(--radius-md);padding:12px 14px;text-align:center;font-size:12.5px;font-weight:700;color:var(--white);width:130px;box-shadow:0 6px 18px rgba(0,0,0,0.4);}
  .eco-node small{display:block;font-weight:500;color:var(--text-dim);font-size:10.5px;margin-top:2px;}
  .eco-hub{top:50%;left:50%;width:150px;background:linear-gradient(135deg,var(--blue),var(--teal));color:#04121f;border:none;box-shadow:0 0 30px rgba(4,159,217,.5);}
  .eco-hub small{color:rgba(4,18,31,.7);}
  .eco-a{top:12%;left:50%;}.eco-b{top:85%;left:18%;}.eco-c{top:85%;left:82%;}

  /* Flow */
  .flow-label{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--teal-light);font-weight:700;margin:22px 0 8px;}
  .flow-row{display:flex;align-items:stretch;gap:0;overflow-x:auto;padding-bottom:10px;}
  .flow-node{flex:0 0 200px;background:var(--navy-800);border:1px solid var(--border-strong);border-radius:var(--radius-md);padding:16px 14px;margin-right:26px;text-align:center;font-size:13px;font-weight:700;color:var(--white);position:relative;display:flex;flex-direction:column;justify-content:center;}
  .flow-node.hub{background:linear-gradient(135deg,var(--blue),var(--teal));color:#04121f;border:none;box-shadow:0 0 22px rgba(4,159,217,.4);}
  .flow-node small{display:block;font-weight:500;color:var(--text-dim);font-size:11px;margin-top:4px;}
  .flow-node.hub small{color:rgba(4,18,31,.7);}
  .flow-node::after{content:"→";position:absolute;right:-24px;top:50%;transform:translateY(-50%);color:var(--teal-light);font-size:20px;font-weight:800;}
  .flow-node:last-child{margin-right:0;}
  .flow-node:last-child::after{display:none;}
  .flow-row.return{flex-direction:row-reverse;}
  .flow-row.return .flow-node{margin-right:0;margin-left:26px;}
  .flow-row.return .flow-node:first-child{margin-left:0;}
  .flow-row.return .flow-node::after{content:"←";left:-24px;right:auto;}

  /* Numbered steps */
  .steps{counter-reset:s;display:flex;flex-direction:column;gap:12px;}
  .steps li{counter-increment:s;list-style:none;position:relative;padding:14px 16px 14px 54px;background:var(--navy-800);border:1px solid var(--border);border-radius:var(--radius-md);font-size:14px;color:var(--text-muted);}
  .steps li::before{content:counter(s);position:absolute;left:14px;top:50%;transform:translateY(-50%);width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--teal));color:#04121f;font-weight:800;display:flex;align-items:center;justify-content:center;font-size:13px;}

  /* Lifecycle */
  .lifecycle{display:flex;overflow-x:auto;padding-bottom:12px;}
  .lc-step{flex:0 0 190px;background:var(--navy-800);border:1px solid var(--border);border-radius:var(--radius-md);padding:16px 14px;margin-right:26px;position:relative;}
  .lc-step:last-child{margin-right:0;}
  .lc-step::after{content:"→";position:absolute;right:-24px;top:50%;transform:translateY(-50%);color:var(--teal-light);font-size:18px;font-weight:800;}
  .lc-step:last-child::after{display:none;}
  .lc-num{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--teal));color:#04121f;font-weight:800;display:flex;align-items:center;justify-content:center;margin-bottom:10px;font-size:13px;}
  .lc-step h4{font-size:13.5px;color:var(--white);margin-bottom:5px;}
  .lc-step p{font-size:12px;margin:0;}

  /* Tiers */
  .tier-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .tier-card{border-radius:var(--radius-lg);padding:28px;cursor:pointer;border:1px solid var(--border);position:relative;overflow:hidden;transition:transform .25s,box-shadow .25s;background:var(--navy-800);}
  .tier-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-card);}
  .tier-diamond{border-top:4px solid var(--diamond);background:linear-gradient(160deg,rgba(95,200,239,.16),rgba(0,194,179,.05));}
  .tier-platinum{border-top:4px solid var(--platinum);background:linear-gradient(160deg,rgba(201,211,220,.12),rgba(255,255,255,.02));}
  .tier-gold{border-top:4px solid var(--gold);background:linear-gradient(160deg,rgba(212,175,55,.18),rgba(212,175,55,.03));}
  .tier-rank{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-dim);font-weight:700;}
  .tier-card h3{font-size:24px;margin:4px 0 8px;color:var(--white);}
  .tier-price{font-size:12.5px;color:var(--teal-light);font-weight:700;margin-bottom:10px;}
  .tier-summary{font-size:13.5px;color:var(--text-muted);}
  .tier-details{max-height:0;overflow:hidden;transition:max-height .35s,opacity .3s;opacity:0;}
  .tier-card.expanded .tier-details{max-height:700px;opacity:1;margin-top:14px;}
  .tier-details ul{list-style:none;display:flex;flex-direction:column;gap:7px;}
  .tier-details li{font-size:13px;color:var(--text-muted);padding-left:18px;position:relative;}
  .tier-details li::before{content:"›";position:absolute;left:0;color:var(--teal-light);font-weight:800;}
  .tier-hint{font-size:12px;color:var(--text-dim);margin-top:12px;display:flex;align-items:center;gap:6px;}
  .tier-hint .chev{transition:transform .3s;}
  .tier-card.expanded .chev{transform:rotate(180deg);}
  .co-pill{font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid var(--border-strong);color:var(--white);}
  .co-row{display:flex;gap:7px;flex-wrap:wrap;margin:8px 0;}

  /* Tier comparison table */
  table{width:100%;border-collapse:collapse;margin-top:16px;font-size:13.5px;}
  th,td{border:1px solid var(--border);padding:10px 12px;text-align:left;vertical-align:top;}
  th{background:rgba(4,159,217,.12);color:var(--white);}
  td{color:var(--text-muted);}
  tr:nth-child(even) td{background:rgba(255,255,255,.02);}
  .td-diamond{color:var(--diamond);font-weight:700;}
  .td-platinum{color:var(--platinum-soft);font-weight:700;}
  .td-gold{color:var(--gold-soft);font-weight:700;}

  /* Flywheel */
  .flywheel{position:relative;width:100%;max-width:540px;aspect-ratio:1/1;margin:0 auto 20px;}
  .flywheel svg{position:absolute;inset:0;width:100%;height:100%;}
  .fw-ring{fill:none;stroke:var(--border-strong);stroke-width:1.5;stroke-dasharray:6 6;}
  .fw-ring.spin{animation:spin 45s linear infinite;transform-origin:50% 50%;}
  @keyframes spin{to{transform:rotate(360deg);}}
  .fw-node{position:absolute;transform:translate(-50%,-50%);width:150px;text-align:center;background:var(--navy-800);border:1px solid var(--border-strong);border-radius:var(--radius-md);padding:11px 12px;font-size:11.5px;font-weight:600;color:var(--text);box-shadow:0 6px 18px rgba(0,0,0,.4);}
  .fw-node .fw-i{display:inline-flex;width:20px;height:20px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--teal));color:#04121f;align-items:center;justify-content:center;font-size:11px;font-weight:800;margin-bottom:5px;}

  /* Architecture */
  .arch-layer{background:var(--navy-800);border:1px solid var(--border);border-radius:var(--radius-md);padding:18px 20px;margin-bottom:14px;border-left:4px solid var(--blue);}
  .arch-layer h4{color:var(--white);font-size:15px;margin-bottom:8px;}
  .arch-layer:nth-child(2){border-left-color:var(--teal);}
  .arch-layer:nth-child(3){border-left-color:var(--blue-light);}
  .arch-layer:nth-child(4){border-left-color:var(--gold);}
  .arch-layer:nth-child(5){border-left-color:var(--platinum);}
  .arch-layer:nth-child(6){border-left-color:#c9a0ff;}

  /* Motions / grids */
  .motion-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;}
  .motion-card{background:var(--navy-800);border:1px solid var(--border);border-radius:var(--radius-md);padding:16px 18px;font-size:13.5px;font-weight:600;color:var(--white);display:flex;align-items:center;gap:11px;}
  .motion-card .dot{width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--teal));flex-shrink:0;}

  /* Accordion */
  .qa-group h3{color:var(--teal-light);font-size:15px;margin:24px 0 10px;}
  details.qa{background:var(--navy-800);border:1px solid var(--border);border-radius:var(--radius-md);margin-bottom:9px;overflow:hidden;}
  details.qa summary{cursor:pointer;padding:15px 20px;font-weight:600;font-size:14.5px;color:var(--white);list-style:none;display:flex;justify-content:space-between;gap:12px;}
  details.qa summary::-webkit-details-marker{display:none;}
  details.qa summary::after{content:"+";font-size:19px;color:var(--teal-light);}
  details.qa[open] summary::after{content:"–";}
  details.qa .qa-body{padding:0 20px 16px;font-size:13.5px;color:var(--text-muted);}

  /* Pilot */
  .pilot-arch{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:24px;}
  .pilot-col{background:var(--navy-800);border:1px solid var(--border);border-radius:var(--radius-md);padding:18px;text-align:center;}
  .pilot-col h4{color:var(--teal-light);font-size:14px;margin-bottom:6px;}
  .pilot-col p{font-size:13px;margin:0;}
  .pilot-layer{background:linear-gradient(90deg,rgba(4,159,217,.14),rgba(0,194,179,.14));border:1px solid var(--border-strong);border-radius:var(--radius-md);padding:14px 18px;text-align:center;font-size:13.5px;font-weight:700;color:var(--white);margin-bottom:24px;}

  .risk-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;}
  .risk-card{background:var(--navy-800);border:1px solid var(--border);border-left:3px solid var(--gold);border-radius:var(--radius-sm);padding:12px 14px;font-size:13px;color:var(--text-muted);}

  .cta-block{text-align:center;padding:52px 40px;border-radius:var(--radius-lg);background:linear-gradient(135deg,rgba(4,159,217,.18),rgba(0,194,179,.14));border:1px solid var(--border-strong);}
  .cta-block h2{color:var(--white);font-size:clamp(24px,4vw,34px);}
  .closing{max-width:720px;margin:26px auto 0;font-size:17px;color:var(--white);font-style:italic;border-top:1px solid var(--border);padding-top:24px;}

  .callout{border-left:3px solid var(--teal);background:rgba(0,194,179,.06);border-radius:var(--radius-md);padding:16px 20px;margin:18px 0;}
  .callout p{margin:0;color:var(--text);}

  footer{padding:36px 0;text-align:center;color:var(--text-dim);font-size:12px;}
  .footer-tags{margin-top:10px;display:flex;justify-content:center;gap:8px;flex-wrap:wrap;}

  .page-foot{display:flex;justify-content:space-between;gap:14px;margin-top:40px;padding-top:24px;border-top:1px solid var(--border);}

  @media (max-width:920px){
    .grid-2,.grid-3,.tier-cards,.pilot-arch{grid-template-columns:1fr;}
    nav.nav-links{justify-content:flex-start;}
  }
  @media (max-width:600px){
    section{padding:48px 0;}
    .eco-diagram{max-width:320px;}
    .eco-node{width:100px;font-size:11px;padding:8px 10px;}
    .page-foot{flex-direction:column;}
  }
  @media (prefers-reduced-motion:reduce){
    *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;}
    html{scroll-behavior:auto;}.fw-ring.spin{animation:none;}
  }
  @media print{
    header.site-nav,.no-print,.page-foot{display:none!important;}
    body{background:#fff;color:#111;}
    .page{display:block!important;}
    section{border-bottom:none;padding:20px 0;page-break-inside:avoid;}
    .card,.tier-card,.flow-node,.lc-step,.motion-card,details.qa,.pilot-col,.arch-layer,.eco-node,.fw-node,.risk-card{background:#fff!important;border:1px solid #ccc!important;color:#111!important;box-shadow:none!important;}
    .hero h1{-webkit-text-fill-color:#111;background:none;color:#111;}
    p,li,td{color:#333!important;}
    .tier-details{max-height:none!important;opacity:1!important;overflow:visible!important;}
  }
</style>
</head>
<body>

<header class="site-nav">
  <div class="progress-bar" id="progressBar"></div>
  <div class="nav-inner">
    <div class="brand"><span class="brand-mark"></span> Cisco Secure AI Tokens</div>
    <nav class="nav-links" id="navLinks">
      <button data-page="overview" class="active">Overview</button>
      <button data-page="problem">Problem</button>
      <button data-page="ecosystem">Ecosystem</button>
      <button data-page="mor">Merchant of Record</button>
      <button data-page="tiers">Token Tiers</button>
      <button data-page="lifecycle">Lifecycle</button>
      <button data-page="whycisco">Why Cisco</button>
      <button data-page="programs">Partner Programs</button>
      <button data-page="flywheel">Flywheel</button>
      <button data-page="architecture">Architecture</button>
      <button data-page="pilot">Pilot</button>
      <button data-page="questions">Open Questions</button>
      <button data-page="risks">Risks</button>
      <button data-page="next">Next Step</button>
    </nav>
    <div class="nav-cta no-print"><button class="btn btn-ghost" id="printBtn">Print / PDF</button></div>
  </div>
</header>

<main id="pages">

<!-- OVERVIEW -->
<div class="page active" id="page-overview">
  <section class="hero">
    <div class="container">
      <div class="tag-row">
        <span class="tag tag-conceptual">Conceptual</span>
        <span class="tag tag-illustrative">Illustrative</span>
        <span class="tag tag-validation">Subject to Validation</span>
